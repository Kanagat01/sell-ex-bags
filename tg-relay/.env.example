# Домен релея (A-запись → IP этого сервера). Caddy выпустит TLS-сертификат на него.
RELAY_DOMAIN=relay.твой-домен.ru

# Токен и чат переезжают сюда (на сервер, где Telegram доступен).
# Для группы: добавить бота в группу, CHAT_ID — отрицательное число (у супергрупп -100…).
# Если группу «повысят» до супергруппы, её id меняется — его надо обновить здесь.
TELEGRAM_BOT_TOKEN=токен-бота
TELEGRAM_CHAT_ID=chat-id

# Общий секрет: тот же, что TELEGRAM_RELAY_SECRET в backend/.env сайта.
# Сгенерируй длинную случайную строку, напр.: openssl rand -hex 32
RELAY_SECRET=длинный-случайный-секрет

# Сторож сайта: сайт пингует relay каждые 5 минут. Если пингов нет дольше
# SITE_SILENCE_MINUTES — письмо на ALERT_EMAILS (одно на аварию + письмо о восстановлении).
SITE_SILENCE_MINUTES=60
ALERT_EMAILS=admin1@example.com,admin2@example.com

# SMTP для этих писем. SMTP_SSL=true — порт 465 (SSL), false — порт 587 (STARTTLS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=your@gmail.com
SMTP_PASSWORD=app-password
ALERT_FROM=your@gmail.com
