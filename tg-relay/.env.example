# Домен релея (A-запись → IP этого сервера). Caddy выпустит TLS-сертификат на него.
RELAY_DOMAIN=relay.твой-домен.ru

# Токен и чат переезжают сюда (на сервер, где Telegram доступен)
TELEGRAM_BOT_TOKEN=токен-бота
TELEGRAM_CHAT_ID=chat-id

# Общий секрет: тот же, что TELEGRAM_RELAY_SECRET в backend/.env сайта.
# Сгенерируй длинную случайную строку, напр.: openssl rand -hex 32
RELAY_SECRET=длинный-случайный-секрет
